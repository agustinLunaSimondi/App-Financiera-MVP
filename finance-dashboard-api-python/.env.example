# Variables de entorno - Backend (finance-dashboard-api-python)
# Copiar este archivo como .env y completar los valores

# Base de datos Supabase — usar el TRANSACTION POOLER (puerto 6543) para runtime.
# Es lo recomendado para apps stateless con muchas conexiones cortas (FastAPI/serverless).
# El session pooler (5432) se reserva para Alembic / scripts, no para runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Opcional: si Alembic falla en 6543 (no soporta prepared statements), usar 5432 solo para migraciones:
# ALEMBIC_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Clave secreta JWT (cualquier string largo y aleatorio, >=32 chars)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET="cambiar-por-un-secret-muy-largo-y-seguro"

# TTL del JWT en minutos (default 60). No subir sin agregar refresh tokens primero.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Clave de encriptación para datos sensibles en reposo (tokens OAuth de MP, etc.).
# OBLIGATORIA. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=""

# Puerto local
PORT=8000

# URL del frontend (en producción: URL de Vercel, separar múltiples con comas)
FRONTEND_URL="http://localhost:5173"

# Mercado Pago (obtener en https://www.mercadopago.com.ar/developers/panel)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# En producción usar la URL de Vercel: https://tu-app.vercel.app/integrations/mercadopago/callback
MP_REDIRECT_URI="http://localhost:5173/integrations/mercadopago/callback"

# Belvo (obtener en https://dashboard.belvo.com — sandbox y production tienen credenciales separadas)
BELVO_SECRET_ID=""
BELVO_SECRET_PASSWORD=""
BELVO_ENV="sandbox"
# Secreto compartido configurado al registrar el webhook en el dashboard de Belvo
BELVO_WEBHOOK_SECRET=""

# Google OAuth (obtener en https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""

# Gemini API Key para el Asistente Inteligente (obtener en https://aistudio.google.com/)
GEMINI_API_KEY=""

# Cloudflare Turnstile (CAPTCHA anti-bot en /register y /waitlist). Obtener secret key en
# dashboard Cloudflare > Turnstile > crear widget. Vacío = verificación desactivada (no-op).
TURNSTILE_SECRET_KEY=""
