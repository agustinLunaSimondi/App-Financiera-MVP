# Variables de entorno - Backend (finance-dashboard-api-python)
# Copiar este archivo como .env y completar los valores

# Base de datos Supabase — usar el TRANSACTION POOLER (puerto 6543) para runtime.
# Es lo recomendado para apps stateless con muchas conexiones cortas (FastAPI/serverless).
# El session pooler (5432) se reserva para Alembic / scripts, no para runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Opcional: si Alembic falla en 6543 (no soporta prepared statements), usar 5432 solo para migraciones:
# ALEMBIC_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Clave secreta JWT (cualquier string largo y aleatorio)
JWT_SECRET="cambiar-por-un-secret-muy-largo-y-seguro"

# Puerto local
PORT=8000

# URL del frontend (en producción: URL de Vercel, separar múltiples con comas)
FRONTEND_URL="http://localhost:5173"

# Mercado Pago (obtener en https://www.mercadopago.com.ar/developers/panel)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# En producción usar la URL de Vercel: https://tu-app.vercel.app/integrations/mercadopago/callback
MP_REDIRECT_URI="http://localhost:5173/integrations/mercadopago/callback"
